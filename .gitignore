# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
.next/
out/
build/
next-env.d.ts

# Secrets — never commit
.env
.env.local
.env.*.local
.env.local.*
!.env.example

# Supabase
supabase/.branches/
supabase/.temp/
supabase/.env
supabase/config.local.toml

# Testing
coverage/
test-results/
playwright-report/
blob-report/
.playwright/

# Production
.vercel/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# transient file list used by the secret scan
.secrets-scan-files.tmp

# Python bytecode. check-assertions.py and check-api-types.py get imported by
# tooling while debugging, and a .pyc in a commit is noise nobody reviews.
__pycache__/
*.pyc

# Vercel CLI token, used only to link and deploy. Never commit it.
.vercel-token
.vercel
.env*
# npm wrote this when the global vercel install failed. The project is pnpm;
# a second lockfile is how two tools end up disagreeing about versions.
package-lock.json

# Local AI tooling. The skills under .opencode/skills are per-machine helpers, not
# product: they are large, they change when the tool updates, and a clone of this
# repository does not need them. Committed once by accident; ignored from here.
.opencode/skills/

# Next.js 16 writes its own agent-rules files on `next dev`. They are framework
# output, regenerated per machine, and not this project's to carry in git.
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Built by scripts/build-drug-register.py from the upstream CC0 register.
# Generated at build time (npm run build:register) so it is never stale in git.
apps/web/data/
backups/
