    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-table": "9.2.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.89.0",
