{
  "name": "bershama",
  "version": "0.1.0",
  "private": true,
  "description": "Pharmaceutical supply chain platform: batch-level inventory, expiry control, requisitions, and live delivery tracking.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "pnpm --filter @bershama/web dev",
    "build": "pnpm --filter @bershama/web build",
    "start": "pnpm --filter @bershama/web start",
    "lint": "pnpm --filter @bershama/web lint",
    "typecheck": "pnpm --filter @bershama/web typecheck",
    "test": "pnpm --filter @bershama/web test",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
