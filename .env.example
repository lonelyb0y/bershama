# PharmaFlow — environment template
#
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# .env.local lives at the REPO ROOT (Next.js resolves it from the project root).
#
# Naming: NEXT_PUBLIC_* is bundled into the browser and MUST only ever hold the
# publishable key. The secret key has no prefix precisely so it stays server-side.
# Use the new-style keys (sb_publishable_... / sb_secret_...). A key starting with
# "eyJ" is a legacy JWT anon/service_role key and is deprecated end of 2026.

# ── Local development (supabase start) ───────────────────────────────────────
# These values are printed by `supabase start`. They are the same for every dev.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_placeholder
SUPABASE_SECRET_KEY=sb_secret_local_placeholder

# ── Hosted project (Supabase Dashboard → Settings → API Keys) ────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...

# ── App ──────────────────────────────────────────────────────────────────────
# Used for the auth redirect allowlist. Localhost in dev, your Vercel domain in prod.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Maps (optional) ──────────────────────────────────────────────────────────
# The driver map draws OpenStreetMap tiles when it can reach them and falls back to a
# plotted route when it cannot, so nothing here is required to run.
#
# Set to `none` to suppress tiles entirely and get the offline plot back. Two reasons to
# do that: an operator with a commercial tile agreement should point this at their own
# provider, and a deployment that would rather not send its drivers' run coordinates to a
# third party should not have to.
#
# Note the public OpenStreetMap tile endpoint is for light use and explicitly not for
# production traffic. At this project's volume that is fine; at real volume it is a
# licensing conversation, not a config change.
# NEXT_PUBLIC_MAP_TILES=osm        # osm (default) | none
